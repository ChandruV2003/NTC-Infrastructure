NTC_RUNTIME_DIR=/root/NTC-Runtime

# Primary NTC transcription worker. The MacBook URL is fallback-only.
NTC_TRANSCRIPTION_PROVIDER=local_http
NTC_TRANSCRIPTION_MODEL=openai/whisper-large-v3
NTC_TRANSCRIPTION_LOCAL_URL=http://100.109.220.95:8766/transcription
NTC_TRANSCRIPTION_LOCAL_URLS=http://100.109.220.95:8766/transcription,http://100.90.245.45:8766/transcription

# No-IP renewal helper. Keep real values in:
# /home/sysadmin/apps/NTC-Infrastructure/config/noip-renew.env
NTC_NOIP_HOSTNAME=ntcnas.myftp.org
NTC_NOIP_AUTO_CONFIRM=0
NTC_NOIP_IMAP_HOST=imap.example.com
NTC_NOIP_IMAP_PORT=993
NTC_NOIP_IMAP_USER=alerts@example.com
NTC_NOIP_IMAP_PASSWORD=change-me
NTC_NOIP_IMAP_MAILBOX=INBOX
NTC_NOIP_IMAP_LOOKBACK_DAYS=45
NTC_NOIP_STATE_DIR=/home/sysadmin/apps/NTC-Infrastructure/state/noip-renew
# Optional command that receives the Markdown report on stdin.
NTC_NOIP_ALERT_CMD=
