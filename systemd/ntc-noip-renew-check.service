[Unit]
Description=NTC No-IP hostname renewal helper
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=sysadmin
WorkingDirectory=/home/sysadmin/developer-workspaces/active/chandruv/NTC-Infrastructure
EnvironmentFile=-/home/sysadmin/apps/NTC-Infrastructure/config/noip-renew.env
ExecStart=/usr/bin/python3 /home/sysadmin/developer-workspaces/active/chandruv/NTC-Infrastructure/tools/noip_confirm_helper.py check
Nice=5
